@page "/status/{status:int}"
@model StatusModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["NoIndex"] = true;
    if (Model.Loading) { ViewData["Refresh"] = EditionGate.RetryAfterSeconds; }
}
<h1 class="page">@Model.Heading</h1>
<p class="lead">@Model.Text</p>
<p><a href="/">На головну</a></p>
